# Server Configuration
PORT=3000
NODE_ENV=production

# Admin Authentication
# Username and password for accessing the admin panel
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# Session Secret
# Used to sign session cookies - change to a random string in production
SESSION_SECRET=change-this-to-a-random-secret-string

# MCP Authentication
# Secret token for accessing the MCP endpoint
# Can be used in path (/mcp/TOKEN) or Authorization header (Bearer TOKEN)
MCP_TOKEN=change-this-to-a-random-mcp-token

# Database
# Path to SQLite database file
DB_PATH=./pollpilot.db

# Base URL
# Public URL where the app is hosted (used for generating links)
# Examples: https://yourdomain.com or https://pollpilot.example.com
BASE_URL=http://localhost:3000
